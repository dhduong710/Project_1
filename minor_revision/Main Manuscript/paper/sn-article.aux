\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Fixed top-20 candidate-ranking comparison across five biomedical datasets.} All values are test metrics under the same absent-gold rank-21 rule. Metrics marked with ($\uparrow $) are better when larger. Bold marks the best value for each dataset and metric. SoftFuse-KGC{} is the main graph-compatible row and should be interpreted as an evidence-calibrated DrKGC{}-style source, not as a universal replacement for the strongest structure-only candidate generator.}}{12}{table.2}\protected@file@percent }
\newlabel{tab:candidate_baselines}{{2}{12}{\textbf {Fixed top-20 candidate-ranking comparison across five biomedical datasets.} All values are test metrics under the same absent-gold rank-21 rule. Metrics marked with ($\uparrow $) are better when larger. Bold marks the best value for each dataset and metric. \softfuse {} is the main graph-compatible row and should be interpreted as an evidence-calibrated \drkgc {}-style source, not as a universal replacement for the strongest structure-only candidate generator}{table.2}{}}
\newlabel{eq:e2e_rr}{{22}{12}{Evaluation metrics}{equation.22}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Candidate stage comparison with structure baselines}{12}{subsection.4.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {End-to-end module comparison for the graph-LLM pipeline.} Gold@20, candidate MRR@20, and E2E MRR@20 are higher-is-better metrics ($\uparrow $), whereas average graph size is lower-is-better ($\downarrow $). E2E MRR@20 uses Llama 3.2 3B candidate-constrained generation with the adjusted-rank rule defined in Section~\ref {sec:evaluation_protocol}. Bold marks the best row for each dataset and metric where the comparison is meaningful.}}{13}{table.3}\protected@file@percent }
\newlabel{tab:module_results}{{3}{13}{\textbf {End-to-end module comparison for the graph-LLM pipeline.} Gold@20, candidate MRR@20, and E2E MRR@20 are higher-is-better metrics ($\uparrow $), whereas average graph size is lower-is-better ($\downarrow $). E2E MRR@20 uses Llama 3.2 3B candidate-constrained generation with the adjusted-rank rule defined in Section~\ref {sec:evaluation_protocol}. Bold marks the best row for each dataset and metric where the comparison is meaningful}{table.3}{}}
