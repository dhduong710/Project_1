\newlabel{eq:candidate_list}{{1}{5}{\drkgc {}-style graph-LLM backbone}{equation.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Overview of the SoftFuse-KGC{} framework}{5}{subsection.3.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Soft support candidate reranking}{5}{subsection.3.3}\protected@file@percent }
\newlabel{eq:evidence_support}{{2}{5}{Soft support candidate reranking}{equation.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {SoftFuse-KGC{} framework for evidence-calibrated biomedical graph-augmented LLM completion.} \textbf  {A. Biomedical backbone preparation} builds the BKG, graph-compatible drug ranker, graph embeddings, path rules, and question templates. \textbf  {B. Candidate and evidence retrieval} converts a therapeutic query into a top-20 candidate list and source evidence subgraph. \textbf  {C. SoftFuse-KGC{} evidence calibration} includes C1 soft support reranking, which combines a rank prior, decomposed positive support, shortcut penalties, and contradiction signals, and C2 confidence-aware fuzzy retrieval, which selects compact evidence using candidate bands, candidate and query incidence, shortcut, conflict, and density cues. \textbf  {D. Graph-enhanced candidate-constrained generation} passes the calibrated candidates and selected graph through the graph adapter and LoRA-tuned LLM to predict one drug}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:framework}{{1}{6}{\textbf {\softfuse {} framework for evidence-calibrated biomedical graph-augmented LLM completion.} \textbf {A. Biomedical backbone preparation} builds the BKG, graph-compatible drug ranker, graph embeddings, path rules, and question templates. \textbf {B. Candidate and evidence retrieval} converts a therapeutic query into a top-20 candidate list and source evidence subgraph. \textbf {C. \softfuse {} evidence calibration} includes C1 soft support reranking, which combines a rank prior, decomposed positive support, shortcut penalties, and contradiction signals, and C2 confidence-aware fuzzy retrieval, which selects compact evidence using candidate bands, candidate and query incidence, shortcut, conflict, and density cues. \textbf {D. Graph-enhanced candidate-constrained generation} passes the calibrated candidates and selected graph through the graph adapter and LoRA-tuned LLM to predict one drug}{figure.1}{}}
\newlabel{eq:path_support}{{3}{6}{Soft support candidate reranking}{equation.3}{}}
\newlabel{eq:schema_support}{{4}{6}{Soft support candidate reranking}{equation.4}{}}
\newlabel{eq:density_support}{{5}{6}{Soft support candidate reranking}{equation.5}{}}
\newlabel{eq:shortcut_penalty}{{6}{7}{Soft support candidate reranking}{equation.6}{}}
\newlabel{eq:conflict_penalty}{{7}{7}{Soft support candidate reranking}{equation.7}{}}
\newlabel{eq:soft_general}{{8}{7}{Soft support candidate reranking}{equation.8}{}}
\newlabel{eq:tie_break}{{9}{7}{Soft support candidate reranking}{equation.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Confidence-aware fuzzy retrieval}{7}{subsection.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Soft support calibration favors graded reranking over a hard filter.} Panel (a) compares the raw DrKGC{}-style source, hard ontology filtering, a contrastive support variant, and the selected soft support b050 setting on PrimeKG validation candidate metrics. Panel (b) reports the top-five direct-link rate. The selected setting preserves Gold@20, improves rank quality, and reduces shortcut exposure, illustrating why the final score combines positive support $E_i(q)$ with shortcut and contradiction penalties instead of applying a binary keep-or-discard rule}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:soft}{{2}{8}{\textbf {Soft support calibration favors graded reranking over a hard filter.} Panel (a) compares the raw \drkgc {}-style source, hard ontology filtering, a contrastive support variant, and the selected soft support b050 setting on PrimeKG validation candidate metrics. Panel (b) reports the top-five direct-link rate. The selected setting preserves Gold@20, improves rank quality, and reduces shortcut exposure, illustrating why the final score combines positive support $E_i(q)$ with shortcut and contradiction penalties instead of applying a binary keep-or-discard rule}{figure.2}{}}
\newlabel{eq:band}{{10}{8}{Confidence-aware fuzzy retrieval}{equation.10}{}}
\newlabel{eq:edge_score}{{11}{8}{Confidence-aware fuzzy retrieval}{equation.11}{}}
\newlabel{eq:edge_touch}{{12}{8}{Confidence-aware fuzzy retrieval}{equation.12}{}}
\newlabel{eq:edge_density}{{13}{8}{Confidence-aware fuzzy retrieval}{equation.13}{}}
\newlabel{eq:fuzzy_select}{{14}{8}{Confidence-aware fuzzy retrieval}{equation.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Confidence-aware fuzzy retrieval selects the compact evidence package used after soft support.} The diagnostic plot compares the soft-support source graph with fuzzy retrieval variants in terms of average subgraph size, direct-shortcut exposure, and candidate coverage. Because fuzzy retrieval preserves the soft-support candidate order, the selected variant is chosen for graph efficiency and evidence cleanliness while maintaining Gold@20, MRR@20, and candidate coverage}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:fuzzy}{{3}{9}{\textbf {Confidence-aware fuzzy retrieval selects the compact evidence package used after soft support.} The diagnostic plot compares the soft-support source graph with fuzzy retrieval variants in terms of average subgraph size, direct-shortcut exposure, and candidate coverage. Because fuzzy retrieval preserves the soft-support candidate order, the selected variant is chosen for graph efficiency and evidence cleanliness while maintaining Gold@20, MRR@20, and candidate coverage}{figure.3}{}}
\newlabel{eq:fuzzy_candidate}{{15}{9}{Confidence-aware fuzzy retrieval}{equation.15}{}}
