\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Case-study evidence graphs for lymphosarcoma / Vincristine and rheumatoid arthritis / Methotrexate.} Circles denote drugs, squares denote diseases, and triangles denote genes or proteins. Thick solid edges show evidence selected by fuzzy retrieval, whereas dashed edges show additional local context. Black outlines identify the query disease and gold drug, making rank changes and retained evidence auditable}}{15}{figure.4}\protected@file@percent }
\newlabel{fig:case}{{4}{15}{\textbf {Case-study evidence graphs for lymphosarcoma / Vincristine and rheumatoid arthritis / Methotrexate.} Circles denote drugs, squares denote diseases, and triangles denote genes or proteins. Thick solid edges show evidence selected by fuzzy retrieval, whereas dashed edges show additional local context. Black outlines identify the query disease and gold drug, making rank changes and retained evidence auditable}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Internal graph evidence and external plausibility evidence for case-study candidates.} Candidate drugs come from the corresponding SoftFuse-KGC{} ranked lists, and internal evidence is extracted from the fuzzy-retrieved graph. The external evidence column provides a literature citation and PubMed identifier for candidate--disease plausibility or related clinical context. These references support plausibility checking and auditability, not prospective clinical validation, graph-edge provenance, or treatment recommendations.}}{15}{table.5}\protected@file@percent }
\newlabel{tab:case_evidence}{{5}{15}{\textbf {Internal graph evidence and external plausibility evidence for case-study candidates.} Candidate drugs come from the corresponding \softfuse {} ranked lists, and internal evidence is extracted from the fuzzy-retrieved graph. The external evidence column provides a literature citation and PubMed identifier for candidate--disease plausibility or related clinical context. These references support plausibility checking and auditability, not prospective clinical validation, graph-edge provenance, or treatment recommendations}{table.5}{}}
