\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces \textbf  {Overview tab.} Controls select the dataset, evaluation split, disease or query case, and displayed top-\(k\). The Query Result panel reports the question, case-study label when available, gold target, prediction, and graph-compression size. The candidate table gives backbone rank, calibrated rank, and soft-support score, with text markers for the target and prediction. The graph panel shows the selected fuzzy evidence subgraph and provides zoom, reset, and drag controls}}{1}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:s1_overview}{{S1}{1}{\textbf {Overview tab.} Controls select the dataset, evaluation split, disease or query case, and displayed top-\(k\). The Query Result panel reports the question, case-study label when available, gold target, prediction, and graph-compression size. The candidate table gives backbone rank, calibrated rank, and soft-support score, with text markers for the target and prediction. The graph panel shows the selected fuzzy evidence subgraph and provides zoom, reset, and drag controls}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {Soft Support tab.} The left panel reports the original lightweight-backbone top-\(k\) order. The center panel shows the final support score and available feature terms, including positive evidence, shared-gene or bridge evidence, and shortcut or contradiction penalties. The right panel gives the calibrated top-\(k\). ``Delta with backbone position'' is calibrated rank minus backbone rank; negative values indicate upward movement}}{2}{figure.caption.3}\protected@file@percent }
\newlabel{fig:s2_soft_support}{{S2}{2}{\textbf {Soft Support tab.} The left panel reports the original lightweight-backbone top-\(k\) order. The center panel shows the final support score and available feature terms, including positive evidence, shared-gene or bridge evidence, and shortcut or contradiction penalties. The right panel gives the calibrated top-\(k\). ``Delta with backbone position'' is calibrated rank minus backbone rank; negative values indicate upward movement}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {Fuzzy Retrieval tab.} The left panel reports the source subgraph, source-edge count, and candidate coverage. The center panel lists fuzzy edge scores and their component terms and can show either retained or removed evidence. The right panel shows the selected compact subgraph. Labels and the legend identify the query disease, top-\(k\) candidates, evidence nodes, and selected edges; color is a redundant visual cue. Zoom, reset, and drag controls support inspection}}{2}{figure.caption.4}\protected@file@percent }
\newlabel{fig:s3_fuzzy_retrieval}{{S3}{2}{\textbf {Fuzzy Retrieval tab.} The left panel reports the source subgraph, source-edge count, and candidate coverage. The center panel lists fuzzy edge scores and their component terms and can show either retained or removed evidence. The right panel shows the selected compact subgraph. Labels and the legend identify the query disease, top-\(k\) candidates, evidence nodes, and selected edges; color is a redundant visual cue. Zoom, reset, and drag controls support inspection}{figure.caption.4}{}}
